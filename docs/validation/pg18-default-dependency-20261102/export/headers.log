(cd /home/nonroot//build/$VERSION && \
env PATH=":$PATH" /home/nonroot//vendor/postgres-$VERSION/configure \
	CFLAGS='-fsigned-char -O2 -g3 ' LDFLAGS='' \
	--enable-debug --with-openssl --with-icu ICU_CFLAGS='-I//usr/local/icu/include -DU_STATIC_IMPLEMENTATION' ICU_LIBS='-L/usr/local/icu/lib -L/usr/local/icu/lib64 -licui18n -licuuc -licudata -lstdc++ -Wl,-Bdynamic -lm' --with-libseccomp INSTALL='/home/nonroot//scripts/ninstall.sh -C' --with-extra-version=" ($EXTRA_VERSION)" \
	--prefix=/home/nonroot/pg_install/$VERSION > configure.log)
